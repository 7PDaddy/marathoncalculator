---
import Page from '../../layouts/Page.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/posts';
const meta = {
  title: 'Marathon Training Blog - MarathonCalculator',
  description: 'Marathon pacing plans, race strategy, and how to use AI for training. Every post opens a live plan in the free Marathon & More Calculator.',
  keywords: 'marathon training blog, marathon pacing strategy, marathon pace plans, running blog',
  path: '/blog/',
  jsonLd: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Marathon Training Blog',
    url: 'https://marathoncalculator.com/blog/',
    isPartOf: { '@type': 'WebSite', name: 'Marathon & More Calculator', url: 'https://marathoncalculator.com/' },
    hasPart: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.title,
      url: new URL(p.url, 'https://marathoncalculator.com').href,
    })),
  },
};
---
<Page {...meta}>
  <div class="intro">
    <h1>The Blog</h1>
    <p>Pacing plans, race strategy, and straight talk about training. Most posts
    open a live plan you can tweak in the calculator.</p>
  </div>

  <section aria-label="All posts">
    {posts.map((p) => <PostCard post={p} />)}
  </section>

  <div class="cta-box" style="margin-top:26px">Looking for the running journal?
    <a href="/journal/">Follow the Phoenix Marathon training here</a>.</div>

  <a class="backlink" href="/">&larr; Back to the calculator</a>
</Page>

<style>
  .intro{text-align:center; margin:8px 0 12px}
  .intro p{color:var(--muted); max-width:520px; margin:0 auto}
</style>
